{
  "name": "Fretty",
  "vendor": "3dthc",
  "uid": "FrTy",
  "version": 810,
  "so": "fretty.so",
  "params": "params.json",
  "defines": {
    "MODULE_SUBDIR": "\"engine\"",
    "HAS_DISPLAY_REV": 1,
    "DISPLAY_REV_NO_UPDATE": 1,
    "HAS_LFO_BPM": 1
  },
  "build": {
    "root": "..",
    "sources": [
      "src/engine.c"
    ],
    "cflags": [
      "-O2",
      "-ffast-math"
    ],
    "libs": [
      "-lm",
      "-lpthread"
    ]
  },
  "layout": "layout.conf",
  "art": "html",
  "presets": "presets.json"
}